# Google Gemini API — used for LLM tasks and Vision (asset description/matching)
GEMINI_API_KEY=your_gemini_api_key_here

# fal.ai — used for ALL image and video generation
FAL_KEY=your_fal_api_key_here

# Google Drive — folder ID where final renders are delivered
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Sheets — spreadsheet ID for the delivery tracking matrix
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Adobe Firefly — Stage 1 image generation (client credentials OAuth)
# Create credentials at https://developer.adobe.com/console/
FIREFLY_CLIENT_ID=your_firefly_client_id_here
FIREFLY_CLIENT_SECRET=your_firefly_client_secret_here

# Google Cloud Storage — for GCS output delivery (optional)
# Service account key JSON file path (leave blank to use Application Default Credentials)
GCS_KEY_FILE=

# Google Drive — folder ID where final renders are delivered
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Sheets — spreadsheet ID for the delivery tracking matrix
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Path to Adobe aerender executable (adjust to your AE version)
AERENDER_PATH=C:/Program Files/Adobe/Adobe After Effects 2025/aerender.exe

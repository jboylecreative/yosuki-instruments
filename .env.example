# Google Gemini API — LLM (brief parsing, copy generation, image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive — OAuth 2.0 app credentials (set once by whoever deploys this app).
# End users just click "Connect Google Drive" in the dashboard — no setup needed on their end.
# To obtain: Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
